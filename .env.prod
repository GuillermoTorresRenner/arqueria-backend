# PRODUCCIÓN — referencia de lo que debe pegarse en el secret PROD_ENV_VARS de GitHub.
# ESTE ARCHIVO SE VERSIONA: no pegues aquí credenciales reales.
# Los valores de verdad van en los secrets de GitHub (PROD_ENV_VARS / QA_ENV_VARS). El host de la BD es `db` (nombre del servicio en el compose).
PREFIX=ABMA_PROD
PORT=4000
NODE_ENV=production

# Base de datos
POSTGRES_USER=abma
POSTGRES_PASSWORD=CAMBIAR
DB_NAME=abma
DB_PORT=5440
DATABASE_URL=postgresql://abma:CAMBIAR@db:5432/abma?schema=public

# Redis
REDIS_PORT=6390

# Auth
JWT_SECRET=CAMBIAR
JWT_EXPIRES_IN=7d

# URLs
FRONTEND_URL=https://PENDIENTE_DOMINIO_PROD

# Rutas de uploads
USER_AVATAR_PATH=public/users_avatar
CONTENT_PATH=public/content

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=arqueria.galadhrym.com
MAIL_PASSWORD=CAMBIAR
MAIL_FROM=arqueria.galadhrym.com

# Invitación al grupo de WhatsApp: solo se entrega tras inscribirse (no es secreta)
WHATSAPP_GROUP_URL=https://chat.whatsapp.com/LkF1rxkIjBqL0qHTwA60au

<html lang='es'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>Preinscripción · {{companyName}}</title>
  </head>
  <!--
    Email HTML: tablas y estilos en línea a propósito. Los clientes de correo
    (sobre todo Outlook) no admiten flexbox, grid ni hojas de estilo externas.
    Paleta tomada del afiche del club: tinta, bermellón, pergamino y sepia.
  -->
  <body style='margin:0;padding:0;background-color:#f2ece0;'>
    <!-- Texto de vista previa: lo que se lee en la bandeja antes de abrir -->
    <div style='display:none;max-height:0;overflow:hidden;opacity:0;'>
      Preinscripción recibida: {{title}}. Datos para pagar la inscripción.
    </div>

    <table
      role='presentation'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='background-color:#f2ece0;padding:24px 12px;'
    >
      <tr>
        <td align='center'>
          <table
            role='presentation'
            width='600'
            cellpadding='0'
            cellspacing='0'
            style='width:100%;max-width:600px;background-color:#fffbf3;border-radius:12px;overflow:hidden;border:1px solid #dcc9a6;'
          >

            <!-- Cabecera -->
            <tr>
              <td
                style='background-color:#1a1310;padding:36px 32px;text-align:center;'
              >
                <div
                  style="font-family:Georgia,'Times New Roman',serif;font-size:30px;font-weight:bold;letter-spacing:2px;color:#edd9b0;"
                >
                  {{companyName}}
                </div>
                <div
                  style='font-family:Arial,sans-serif;font-size:11px;letter-spacing:4px;text-transform:uppercase;color:#b9a488;padding-top:6px;'
                >
                  Arquería Tradicional
                </div>
                <div
                  style='width:60px;height:3px;background-color:#c1272d;margin:18px auto 0;'
                ></div>
              </td>
            </tr>

            <!-- Cuerpo -->
            <tr>
              <td style='padding:36px 32px 8px;font-family:Arial,sans-serif;color:#1f1710;'>
                <p style='margin:0 0 6px;font-size:12px;letter-spacing:2px;text-transform:uppercase;font-weight:bold;color:#b7791f;'>
                  Preinscripción recibida
                </p>
                <h1 style='margin:0 0 16px;font-size:22px;font-weight:bold;color:#1f1710;'>
                  ¡Hola, {{firstName}}!
                </h1>
                <p style='margin:0 0 14px;font-size:15px;line-height:1.65;color:#4a3a2a;'>
                  Quedaste <strong>preinscrito</strong>. Para completar tu inscripción,
                  transfiere el monto que corresponda y envíanos el comprobante.
                </p>
                <table
                  role='presentation'
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  style='background-color:#f7efdf;border:1px solid #e6d6b8;border-radius:8px;'
                >
                  <tr>
                    <td style='padding:14px 18px;font-size:14px;line-height:1.6;color:#1f1710;'>
                      <strong style='color:#8b5e34;'>Torneo:</strong> {{title}}<br />
                      <strong style='color:#8b5e34;'>Cuándo:</strong> {{date}}, {{time}}
                      {{#if place}}
                        <br />
                        <strong style='color:#8b5e34;'>Dónde:</strong>
                        {{place.name}}{{#if place.address}} · {{place.address}}{{/if}}
                        {{#if mapUrl}}
                          <br /><a href='{{mapUrl}}' style='color:#a81e24;font-size:13px;'>Ver en el mapa</a>
                        {{/if}}
                      {{/if}}
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            {{#if fees.length}}
              <tr>
                <td style='padding:22px 32px 0;font-family:Arial,sans-serif;'>
                  <h2 style='margin:0 0 8px;font-size:17px;color:#1f1710;'>Montos</h2>
                  <table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='font-size:14px;color:#1f1710;'>
                    {{#each fees}}
                      <tr>
                        <td style='padding:6px 0;border-bottom:1px solid #eadcc0;'>{{label}}</td>
                        <td style='padding:6px 0;border-bottom:1px solid #eadcc0;text-align:right;font-weight:bold;'>{{amount}}</td>
                      </tr>
                    {{/each}}
                  </table>
                </td>
              </tr>
            {{/if}}

            {{#if bank.length}}
              <tr>
                <td style='padding:22px 32px 0;font-family:Arial,sans-serif;'>
                  <h2 style='margin:0 0 8px;font-size:17px;color:#1f1710;'>Datos de transferencia</h2>
                  <table role='presentation' width='100%' cellpadding='0' cellspacing='0' style='background-color:#f7efdf;border:1px solid #e6d6b8;border-radius:8px;font-size:14px;color:#1f1710;'>
                    {{#each bank}}
                      <tr>
                        <td style='padding:8px 16px;color:#6b5539;width:42%;'>{{label}}</td>
                        <td style='padding:8px 16px;font-weight:bold;'>{{value}}</td>
                      </tr>
                    {{/each}}
                  </table>
                </td>
              </tr>
            {{/if}}

            {{#if instructions}}
              <tr>
                <td style='padding:16px 32px 0;font-family:Arial,sans-serif;font-size:14px;line-height:1.65;color:#4a3a2a;white-space:pre-line;'>{{instructions}}</td>
              </tr>
            {{/if}}

            <!-- Comprobante -->
            <tr>
              <td style='padding:24px 32px 6px;text-align:center;font-family:Arial,sans-serif;'>
                <p style='margin:0 0 14px;font-size:15px;line-height:1.6;color:#1f1710;'>
                  <strong>Envíanos el comprobante</strong> respondiendo este correo o escribiendo a
                  <a href='mailto:{{supportEmail}}' style='color:#a81e24;'>{{supportEmail}}</a>.
                </p>
                <a
                  href='{{receiptUrl}}'
                  style='display:inline-block;background-color:#a81e24;color:#fff8ee;font-size:15px;font-weight:bold;text-decoration:none;padding:14px 32px;border-radius:8px;'
                >
                  Enviar comprobante
                </a>
                <p style='margin:10px 0 0;font-size:12px;color:#8a7a63;'>
                  Asunto sugerido: {{receiptSubject}}
                </p>
              </td>
            </tr>
            <tr>
              <td style='padding:14px 32px 30px;text-align:center;font-family:Arial,sans-serif;font-size:13px;line-height:1.6;color:#6b5539;'>
                Cuando verifiquemos el pago te confirmaremos la inscripción por correo.
                Puedes ver el estado en <a href='{{accountUrl}}' style='color:#a81e24;'>tu cuenta</a>.
              </td>
            </tr>

            <!-- Pie -->
            <tr>
              <td
                style='background-color:#f0e4ca;padding:22px 32px;text-align:center;font-family:Arial,sans-serif;border-top:1px solid #dcc9a6;'
              >
                <p
                  style='margin:0 0 6px;font-size:12px;line-height:1.6;color:#6b5539;'
                >
                  ¿Dudas? Escríbenos a
                  <a
                    href='mailto:{{supportEmail}}'
                    style='color:#a81e24;text-decoration:none;'
                  >{{supportEmail}}</a>
                </p>
                <p
                  style='margin:0 0 6px;font-size:11px;line-height:1.6;color:#8a7a63;'
                >
                  Recibes este correo por tu inscripción en un torneo de
                  {{companyName}}.
                </p>
                <p style='margin:0;font-size:11px;color:#8a7a63;'>
                  ©
                  {{currentYear}}
                  {{companyName}}
                  · Este es un correo automático.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
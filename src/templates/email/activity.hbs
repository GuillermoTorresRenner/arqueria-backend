<html lang='es'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <title>{{title}} · {{companyName}}</title>
  </head>
  <!--
    Email HTML: tablas y estilos en línea a propósito. Los clientes de correo
    (sobre todo Outlook) no admiten flexbox, grid ni hojas de estilo externas.
    Paleta tomada del afiche del club: tinta, bermellón, pergamino y sepia.
  -->
  <body style='margin:0;padding:0;background-color:#f2ece0;'>
    <!-- Texto de vista previa: lo que se lee en la bandeja antes de abrir -->
    <div style='display:none;max-height:0;overflow:hidden;opacity:0;'>
      {{title}}: {{date}}, {{time}}.
    </div>

    <table
      role='presentation'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      style='background-color:#f2ece0;padding:24px 12px;'
    >
      <tr>
        <td align='center'>
          <table
            role='presentation'
            width='600'
            cellpadding='0'
            cellspacing='0'
            style='width:100%;max-width:600px;background-color:#fffbf3;border-radius:12px;overflow:hidden;border:1px solid #dcc9a6;'
          >

            <!-- Cabecera -->
            <tr>
              <td
                style='background-color:#1a1310;padding:36px 32px;text-align:center;'
              >
                <div
                  style="font-family:Georgia,'Times New Roman',serif;font-size:30px;font-weight:bold;letter-spacing:2px;color:#edd9b0;"
                >
                  {{companyName}}
                </div>
                <div
                  style='font-family:Arial,sans-serif;font-size:11px;letter-spacing:4px;text-transform:uppercase;color:#b9a488;padding-top:6px;'
                >
                  Arquería Tradicional
                </div>
                <div
                  style='width:60px;height:3px;background-color:#c1272d;margin:18px auto 0;'
                ></div>
              </td>
            </tr>

            <!-- Cuerpo -->
            <tr>
              <td
                style='padding:36px 32px 8px;font-family:Arial,sans-serif;color:#1f1710;'
              >
                <p
                  style='margin:0 0 6px;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#8b5e34;'
                >
                  Nueva actividad del club
                </p>
                <h1
                  style='margin:0 0 16px;font-size:24px;font-weight:bold;color:#1f1710;'
                >
                  {{title}}
                </h1>
                <p
                  style='margin:0 0 18px;font-size:15px;line-height:1.65;color:#4a3a2a;'
                >
                  Hola, {{firstName}}. Te contamos los detalles para que
                  puedas organizarte:
                </p>

                <!-- Cuándo y dónde -->
                <table
                  role='presentation'
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  style='background-color:#f7efdf;border:1px solid #e6d6b8;border-radius:8px;'
                >
                  <tr>
                    <td style='padding:14px 18px;font-size:14px;line-height:1.6;color:#1f1710;'>
                      <strong style='color:#8b5e34;'>Cuándo:</strong>
                      {{date}},
                      {{time}}
                      {{#if place}}
                        <br />
                        <strong style='color:#8b5e34;'>Dónde:</strong>
                        {{place.name}}{{#if place.address}} · {{place.address}}{{/if}}
                        {{#if mapUrl}}
                          <br />
                          <a href='{{mapUrl}}' style='color:#a81e24;font-size:13px;'>Ver en el mapa</a>
                        {{/if}}
                      {{/if}}
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            {{#if forecast}}
              <!-- Pronóstico -->
              <tr>
                <td style='padding:14px 32px 0;font-family:Arial,sans-serif;'>
                  <table
                    role='presentation'
                    width='100%'
                    cellpadding='0'
                    cellspacing='0'
                    style='border:1px solid #e6d6b8;border-left:4px solid {{forecast.color}};border-radius:8px;'
                  >
                    <tr>
                      <td style='padding:12px 16px;font-size:14px;line-height:1.6;color:#1f1710;'>
                        <strong style='color:{{forecast.color}};'>{{forecast.statusLabel}}</strong>
                        <br />
                        {{forecast.description}} · {{forecast.tempMin}}–{{forecast.tempMax}} °C ·
                        lluvia {{forecast.precipitationProbability}} % · viento hasta
                        {{forecast.gustsMax}} km/h
                        {{#if forecast.reasons}}
                          <br />
                          <span style='font-size:13px;color:#6b5539;'>{{forecast.reasons}}</span>
                        {{/if}}
                        <br />
                        <span style='font-size:11px;color:#8a7a63;'>Pronóstico de Open-Meteo para las horas de la actividad; puede cambiar.</span>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            {{/if}}

            {{#if recommendations}}
              <!-- Recomendaciones (HTML del editor del panel) -->
              <tr>
                <td
                  style='padding:22px 32px 0;font-family:Arial,sans-serif;font-size:15px;line-height:1.65;color:#4a3a2a;'
                >
                  <h2 style='margin:0 0 8px;font-size:17px;color:#1f1710;'>Recomendaciones</h2>
                  {{recommendations}}
                </td>
              </tr>
            {{/if}}

            <!-- Botón principal -->
            <tr>
              <td style='padding:26px 32px 30px;text-align:center;'>
                <a
                  href='{{confirmUrl}}'
                  style='display:inline-block;background-color:#a81e24;color:#fff8ee;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;text-decoration:none;padding:14px 32px;border-radius:8px;'
                >
                  Confirmar asistencia
                </a>
                <p style='margin:10px 0 0;font-family:Arial,sans-serif;font-size:12px;color:#8a7a63;'>
                  Entra con tu cuenta del club para confirmar.
                </p>
              </td>
            </tr>

            <!-- Pie -->
            <tr>
              <td
                style='background-color:#f0e4ca;padding:22px 32px;text-align:center;font-family:Arial,sans-serif;border-top:1px solid #dcc9a6;'
              >
                <p
                  style='margin:0 0 6px;font-size:12px;line-height:1.6;color:#6b5539;'
                >
                  ¿Dudas? Escríbenos a
                  <a
                    href='mailto:{{supportEmail}}'
                    style='color:#a81e24;text-decoration:none;'
                  >{{supportEmail}}</a>
                </p>
                <p
                  style='margin:0 0 6px;font-size:11px;line-height:1.6;color:#8a7a63;'
                >
                  Recibes este correo porque eres socio de
                  {{companyName}}
                  y aceptaste recibir comunicaciones del club por email.
                </p>
                <p style='margin:0;font-size:11px;color:#8a7a63;'>
                  ©
                  {{currentYear}}
                  {{companyName}}
                  · Este es un correo automático.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
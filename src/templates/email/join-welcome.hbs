<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Valida tu correo · {{companyName}}</title>
  </head>
  <!--
    Email HTML: tablas y estilos en línea a propósito. Los clientes de correo
    (sobre todo Outlook) no admiten flexbox, grid ni hojas de estilo externas.
    Paleta tomada del afiche del club: tinta, bermellón, pergamino y sepia.
  -->
  <body style="margin:0;padding:0;background-color:#f2ece0;">
    <!-- Texto de vista previa: lo que se lee en la bandeja antes de abrir -->
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;">
      Valida tu correo para activar tu cuenta en {{companyName}}.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
      style="background-color:#f2ece0;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0"
            style="width:100%;max-width:600px;background-color:#fffbf3;border-radius:12px;overflow:hidden;border:1px solid #dcc9a6;">

            <!-- Cabecera -->
            <tr>
              <td style="background-color:#1a1310;padding:36px 32px;text-align:center;">
                <div style="font-family:Georgia,'Times New Roman',serif;font-size:30px;font-weight:bold;letter-spacing:2px;color:#edd9b0;">
                  {{companyName}}
                </div>
                <div style="font-family:Arial,sans-serif;font-size:11px;letter-spacing:4px;text-transform:uppercase;color:#b9a488;padding-top:6px;">
                  Arquería Tradicional
                </div>
                <div style="width:60px;height:3px;background-color:#c1272d;margin:18px auto 0;"></div>
              </td>
            </tr>

            <!-- Cuerpo -->
            <tr>
              <td style="padding:36px 32px 8px;font-family:Arial,sans-serif;color:#1f1710;">
                <h1 style="margin:0 0 16px;font-size:22px;font-weight:bold;color:#1f1710;">
                  ¡Gracias por sumarte, {{firstName}}!
                </h1>
                <p style="margin:0 0 14px;font-size:15px;line-height:1.65;color:#4a3a2a;">
                  Recibimos tu inscripción en <strong>{{companyName}}</strong>. Para
                  activar tu cuenta, valida tu correo y crea tu contraseña: con ella
                  podrás entrar al sitio del club.
                </p>
                <p style="margin:0 0 14px;font-size:15px;line-height:1.65;color:#4a3a2a;">
                  Muy pronto encontrarás allí el calendario de actividades y las
                  inscripciones a los torneos.
                </p>
              </td>
            </tr>

            <!-- Botón principal -->
            <tr>
              <td style="padding:20px 32px 6px;text-align:center;">
                <a href="{{verifyUrl}}"
                  style="display:inline-block;background-color:#a81e24;color:#fff8ee;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;text-decoration:none;padding:14px 32px;border-radius:8px;">
                  Validar mi correo
                </a>
              </td>
            </tr>
            <tr>
              <td style="padding:6px 32px 18px;text-align:center;font-family:Arial,sans-serif;">
                <p style="margin:0;font-size:12px;line-height:1.6;color:#8a7a63;">
                  El enlace vale {{validDays}} días y sirve una sola vez. Si el botón no
                  funciona, copia esta dirección en tu navegador:<br />
                  <a href="{{verifyUrl}}" style="color:#a81e24;word-break:break-all;">{{verifyUrl}}</a>
                </p>
              </td>
            </tr>

            {{#if whatsappUrl}}
              <tr>
                <td style="padding:6px 32px 28px;text-align:center;font-family:Arial,sans-serif;">
                  <p style="margin:0 0 10px;font-size:14px;color:#4a3a2a;">
                    Y si aún no entraste, este es el grupo del club:
                  </p>
                  <a href="{{whatsappUrl}}"
                    style="display:inline-block;border:1px solid #8b5e34;color:#6b4a28;font-size:14px;text-decoration:none;padding:10px 22px;border-radius:8px;">
                    Entrar al grupo de WhatsApp
                  </a>
                </td>
              </tr>
            {{/if}}

            <!-- Pie -->
            <tr>
              <td style="background-color:#f0e4ca;padding:22px 32px;text-align:center;font-family:Arial,sans-serif;border-top:1px solid #dcc9a6;">
                <p style="margin:0 0 6px;font-size:12px;line-height:1.6;color:#6b5539;">
                  ¿Dudas? Escríbenos a
                  <a href="mailto:{{supportEmail}}" style="color:#a81e24;text-decoration:none;">{{supportEmail}}</a>
                </p>
                <p style="margin:0 0 6px;font-size:11px;line-height:1.6;color:#8a7a63;">
                  Recibes este correo porque te inscribiste en {{companyName}} y
                  aceptaste recibir comunicaciones del club por email.
                </p>
                <p style="margin:0;font-size:11px;color:#8a7a63;">
                  © {{currentYear}} {{companyName}} · Este es un correo automático.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

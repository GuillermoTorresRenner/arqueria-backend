/// Un Score es una SERIE (end) de un arquero en una ronda: el grano con el que
/// los jueces cargan desde el móvil. El total de la ronda se agrega sumando series.

model Score {
  id        String @id @default(cuid())
  roundId   String
  memberId  String
  endNumber Int /// número de serie dentro de la ronda, 1..endsPerRound
  /// Flechas de la serie: [{ "label": "X", "value": 10 }, ...]
  /// Se valida contra las zones del ScoringFormat del torneo.
  arrows    Json
  /// Suma de la serie, calculada en el backend — nunca se confía en el cliente.
  total     Int
  /// Desempates acumulados en la serie (cantidad de X y de 10).
  innerTens Int    @default(0)
  tens      Int    @default(0)

  status        ScoreStatus @default(DRAFT)
  recordedById  String /// juez o admin que la cargó
  validatedById String?
  validatedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  round       Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  member      Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recordedBy  Users  @relation("ScoreRecordedBy", fields: [recordedById], references: [id])
  validatedBy Users? @relation("ScoreValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)

  @@unique([roundId, memberId, endNumber])
  @@index([roundId, memberId])
  @@map("scores")
}

enum ScoreStatus {
  DRAFT /// cargada, aún editable por el juez
  CONFIRMED /// cerrada por el juez
  VALIDATED /// revisada por un admin
}

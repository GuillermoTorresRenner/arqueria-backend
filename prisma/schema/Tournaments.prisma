/// Formato de puntuación PARAMETRIZABLE. Las modalidades del club están por definir,
/// así que aquí no se hardcodea ninguna regla (ni World Archery ni 3D): el torneo
/// declara su formato y el backend valida cada flecha contra él.
model ScoringFormat {
  id           String   @id @default(cuid())
  name         String   @unique /// "WA 18m indoor", "3D club"
  description  String?
  arrowsPerEnd Int /// flechas por serie
  endsPerRound Int /// series por ronda
  maxPerArrow  Int /// puntaje máximo de una flecha
  /// Zonas válidas: [{ "label": "X", "value": 10, "isInner": true }, ...]
  /// El orden define cómo se desempata (más X, luego más 10, etc.).
  zones        Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournaments Tournament[]

  @@map("scoring_formats")
}

model Tournament {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  description     String?
  location        String?
  startsAt        DateTime
  endsAt          DateTime?
  registrationEnd DateTime?
  /// Opcional: un torneo creado desde el calendario define su modalidad después
  scoringFormatId String?
  status          TournamentStatus @default(DRAFT)
  /// Publica el marcador en vivo para el público
  isPublic        Boolean          @default(false)
  maxParticipants Int?
  /// Reglamento redactado (HTML del editor); los archivos van en documents
  rules           String?
  /// Video instructivo de YouTube
  youtubeUrl      String?
  /// Datos de transferencia: banco, cuenta, titular, instrucciones y montos
  /// ({ bankName, accountType, accountNumber, holderName, holderRut,
  /// holderEmail, instructions, fees: [{ label, amount }] })
  paymentInfo     Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  scoringFormat ScoringFormat?       @relation(fields: [scoringFormatId], references: [id], onDelete: Restrict)
  rounds        Round[]
  groups        TournamentGroup[]
  registrations Registration[]
  draws         GroupDraw[]
  activity      Activity?
  judges        TournamentJudge[]
  documents     TournamentDocument[]

  @@index([status, startsAt])
  @@map("tournaments")
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model Round {
  id           String   @id @default(cuid())
  tournamentId String
  name         String /// "Clasificatoria", "Eliminatoria"
  order        Int      @default(0)
  distance     Int? /// metros, si aplica a la modalidad
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  scores     Score[]

  @@unique([tournamentId, order])
  @@map("rounds")
}

/// Grupo/paralela. Se arma por sorteo aleatorio y el admin puede reasignar a mano.
model TournamentGroup {
  id           String   @id @default(cuid())
  tournamentId String
  name         String /// "Paralela A", "Grupo 1"
  order        Int      @default(0)
  /// Juez asignado: solo él (y un ADMIN) puede cargar puntajes de este grupo.
  judgeId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament    Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  judge         Users?         @relation(fields: [judgeId], references: [id], onDelete: SetNull)
  registrations Registration[]

  @@unique([tournamentId, order])
  @@index([judgeId])
  @@map("tournament_groups")
}

/// Registro del sorteo, con su semilla, para que sea auditable y reproducible.
model GroupDraw {
  id           String   @id @default(cuid())
  tournamentId String
  seed         String /// semilla usada por el PRNG
  strategy     String   @default("RANDOM")
  /// Foto del resultado: [{ groupId, memberIds: [...] }]
  result       Json
  drawnById    String?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  drawnBy    Users?     @relation(fields: [drawnById], references: [id], onDelete: SetNull)

  @@index([tournamentId, createdAt])
  @@map("group_draws")
}

model Registration {
  id            String             @id @default(cuid())
  tournamentId  String
  memberId      String
  groupId       String?
  /// Posición dentro del grupo (diana/petate)
  position      Int?
  /// PENDING: preinscrito, esperando el comprobante de pago.
  /// CONFIRMED: un admin verificó el pago y lo dejó inscrito.
  status        RegistrationStatus @default(PENDING)
  confirmedAt   DateTime?
  confirmedById String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tournament  Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  member      Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  group       TournamentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  confirmedBy Users?           @relation("RegistrationConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([tournamentId, memberId])
  @@index([groupId])
  @@map("registrations")
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WITHDRAWN
}

/// Jueces del torneo (usuarios ADMIN o JUDGE). Aparte de los jueces de cada
/// grupo, que se asignan al armar los grupos.
model TournamentJudge {
  tournamentId String
  userId       String
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       Users      @relation("TournamentJudges", fields: [userId], references: [id], onDelete: Cascade)

  @@id([tournamentId, userId])
  @@index([userId])
  @@map("tournament_judges")
}

/// Reglamentos y bases subidos como archivo (PDF, Word, PowerPoint…)
model TournamentDocument {
  id           String   @id @default(cuid())
  tournamentId String
  /// Nombre original, para mostrarlo y descargarlo con él
  name         String
  /// Ruta relativa a public/ ("documents/tournaments/x.pdf")
  path         String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@map("tournament_documents")
}

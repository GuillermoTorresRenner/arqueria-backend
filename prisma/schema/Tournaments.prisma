/// Zonas de una diana, PARAMETRIZABLES: las modalidades se cargan como datos
/// (p. ej. «Diana turca 0-1-2») y el backend valida cada flecha contra ellas.
/// Cuántas flechas se tiran lo define cada ronda de la categoría, no la diana.
model ScoringFormat {
  id          String   @id @default(cuid())
  name        String   @unique /// "Diana turca 0-1-2"
  description String?
  /// Zonas válidas: [{ "label": "2", "value": 2 }, { "label": "1", "value": 1 }, ...]
  zones       Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories TournamentCategory[]

  @@map("scoring_formats")
}

model Tournament {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  description     String?
  location        String?
  startsAt        DateTime
  endsAt          DateTime?
  registrationEnd DateTime?
  status          TournamentStatus @default(DRAFT)
  /// Publica el marcador en vivo para el público
  isPublic        Boolean          @default(false)
  maxParticipants Int?
  /// Reglamento redactado (HTML del editor); los archivos van en documents
  rules           String?
  /// Video instructivo de YouTube
  youtubeUrl      String?
  /// Cuenta a la que se transfiere la inscripción (ver BankAccount)
  bankAccountId   String?
  /// Lo propio de cada torneo: { instructions, fees: [{ label, amount }] }
  paymentInfo     Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  /// Restrict: una cuenta asignada a torneos no se borra, se desactiva
  bankAccount   BankAccount?            @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  categories    TournamentCategory[]
  participants  TournamentParticipant[]
  registrations Registration[]
  activity      Activity?
  judges        TournamentJudge[]
  documents     TournamentDocument[]

  @@index([status, startsAt])
  @@index([bankAccountId])
  @@map("tournaments")
}

/// Cuentas bancarias para pagar inscripciones por transferencia. Se guardan
/// una vez y se eligen desde un desplegable en cada torneo.
model BankAccount {
  id            String   @id @default(cuid())
  bankName      String
  accountType   String
  accountNumber String
  holderName    String
  holderRut     String
  holderEmail   String?
  /// Una cuenta en desuso no se ofrece en los torneos nuevos, pero los
  /// antiguos la conservan.
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tournaments Tournament[]

  @@unique([bankName, accountNumber])
  @@map("bank_accounts")
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum CategoryMode {
  SCORE /// puntaje: diana por zonas; gana la suma mayor
  KNOCKDOWN /// duelos: dianas abatibles; gana quien abate primero las fijadas
}

/// Categoría de competencia de un torneo («Tiro tradicional», «Duelos»). Cada
/// una tiene su propio cuadro de eliminación directa 1 contra 1.
model TournamentCategory {
  id              String       @id @default(cuid())
  tournamentId    String
  name            String
  order           Int          @default(0)
  mode            CategoryMode @default(SCORE)
  /// SCORE: zonas de la diana
  scoringFormatId String?
  /// SCORE: flechas por arquero en cada ronda (cada ronda puede cambiarlo)
  arrowsPerArcher Int          @default(3)
  /// KNOCKDOWN: dianas abatidas para ganar el enfrentamiento
  targetsToWin    Int          @default(3)
  /// Flechas por arquero en cada tanda de desempate (muerte súbita)
  shootOffArrows  Int          @default(1)
  /// Flechas por arquero en la minironda entre perdedores empatados
  playoffArrows   Int          @default(1)
  /// Juez de la categoría: cuenta y valida en la diana
  judgeId         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tournament    Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  scoringFormat ScoringFormat? @relation(fields: [scoringFormatId], references: [id], onDelete: Restrict)
  judge         Users?         @relation("CategoryJudge", fields: [judgeId], references: [id], onDelete: SetNull)
  registrations Registration[]
  rounds        BracketRound[]

  @@unique([tournamentId, name])
  @@index([judgeId])
  @@map("tournament_categories")
}

/// Arquero en un torneo, con su número de participante: una serie consecutiva
/// 1..N que se asigna al inscribirse y es el mismo en todas sus categorías.
/// Hasta el sorteo se renumera si alguien se retira; desde ahí queda fijo.
model TournamentParticipant {
  id           String   @id @default(cuid())
  tournamentId String
  memberId     String
  number       Int
  createdAt    DateTime @default(now())

  tournament    Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  member        Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  registrations Registration[]
  matchEntries  MatchEntry[]

  @@unique([tournamentId, memberId])
  @@unique([tournamentId, number])
  @@map("tournament_participants")
}

/// Inscripción en UNA categoría: cada una se paga y se confirma por separado.
/// El participante (y su número) es el par torneo + socio.
model Registration {
  id            String             @id @default(cuid())
  tournamentId  String
  memberId      String
  categoryId    String
  /// PENDING: preinscrito, esperando el comprobante de pago.
  /// CONFIRMED: un admin verificó el pago y lo dejó inscrito.
  status        RegistrationStatus @default(PENDING)
  confirmedAt   DateTime?
  confirmedById String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tournament  Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  member      Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  category    TournamentCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  participant TournamentParticipant @relation(fields: [tournamentId, memberId], references: [tournamentId, memberId], onDelete: Restrict)
  confirmedBy Users?                @relation("RegistrationConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([categoryId, memberId])
  @@index([tournamentId, memberId])
  @@map("registrations")
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WITHDRAWN
}

/// Jueces del torneo (usuarios ADMIN o JUDGE). Aparte de los jueces de cada
/// grupo, que se asignan al armar los grupos.
model TournamentJudge {
  tournamentId String
  userId       String
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       Users      @relation("TournamentJudges", fields: [userId], references: [id], onDelete: Cascade)

  @@id([tournamentId, userId])
  @@index([userId])
  @@map("tournament_judges")
}

/// Reglamentos y bases subidos como archivo (PDF, Word, PowerPoint…)
model TournamentDocument {
  id           String   @id @default(cuid())
  tournamentId String
  /// Nombre original, para mostrarlo y descargarlo con él
  name         String
  /// Ruta relativa a public/ ("documents/tournaments/x.pdf")
  path         String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@map("tournament_documents")
}

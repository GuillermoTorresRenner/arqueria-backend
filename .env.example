# Copia este archivo a .env para desarrollo local.
# En QA/prod estas variables viven en los secrets QA_ENV_VARS / PROD_ENV_VARS de GitHub.

PREFIX=ABMA_DEV
PORT=4000
NODE_ENV=development

# Base de datos
POSTGRES_USER=abma
POSTGRES_PASSWORD=abma_local
DB_NAME=abma
DB_PORT=5440
DATABASE_URL=postgresql://abma:abma_local@localhost:5440/abma?schema=public

# Redis
REDIS_PORT=6390

# Auth
JWT_SECRET=cambiar_en_produccion
JWT_EXPIRES_IN=7d

# URLs
FRONTEND_URL=http://localhost:5173

# Rutas de uploads
USER_AVATAR_PATH=public/users_avatar
CONTENT_PATH=public/content

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# Poner en 'false' solo para un SMTP local de pruebas sin TLS
MAIL_REQUIRE_TLS=true
